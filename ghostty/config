theme = Gruvbox Dark

# Free the default split bindings that collide with Rectangle's
# Spectacle-style shortcuts (cmd+opt+arrows, cmd+ctrl+arrows)
keybind = super+alt+arrow_left=unbind
keybind = super+alt+arrow_right=unbind
keybind = super+alt+arrow_up=unbind
keybind = super+alt+arrow_down=unbind
keybind = super+ctrl+arrow_left=unbind
keybind = super+ctrl+arrow_right=unbind
keybind = super+ctrl+arrow_up=unbind
keybind = super+ctrl+arrow_down=unbind

# tmux-style splits with C-a prefix (mirrors tmux.conf)
keybind = ctrl+a>shift+backslash=new_split:right
keybind = ctrl+a>minus=new_split:down
keybind = ctrl+a>h=goto_split:left
keybind = ctrl+a>j=goto_split:down
keybind = ctrl+a>k=goto_split:up
keybind = ctrl+a>l=goto_split:right
keybind = ctrl+a>shift+h=resize_split:left,20
keybind = ctrl+a>shift+j=resize_split:down,20
keybind = ctrl+a>shift+k=resize_split:up,20
keybind = ctrl+a>shift+l=resize_split:right,20
keybind = ctrl+a>equal=equalize_splits
keybind = ctrl+a>z=toggle_split_zoom
# C-a C-a sends a literal C-a, like tmux's send-prefix
keybind = ctrl+a>ctrl+a=text:\x01
